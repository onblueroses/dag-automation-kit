# Copy to .env and fill in. Never commit your real .env (it is gitignored).

# --- Approval-gate server (src/infra) ---
# Required to run the human-in-the-loop approval server.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=replace-me
SMTP_FROM=approvals@example.com
NOTIFY_TO=reviewer@example.com
APPROVAL_BASE_URL=http://localhost:3008
PORT=3008
DB_PATH=workflows.db

# --- Node credentials (optional) ---
# These are injected via createExecutionContext(services, vars, credentials),
# not read from the environment by nodes. Load them from here in your own entry
# point and pass them in. Set only the ones whose nodes you use.
OPENROUTER_API_KEY=replace-me
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
ELEVENLABS_API_KEY=replace-me
FIRECRAWL_API_KEY=replace-me
TAVILY_API_KEY=replace-me
UNSPLASH_ACCESS_KEY=replace-me
YOUTUBE_API_KEY=replace-me
DISCORD_BOT_TOKEN=replace-me
DATAFORSEO_LOGIN=replace-me
DATAFORSEO_PASSWORD=replace-me
