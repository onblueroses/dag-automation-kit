{
	"name": "dag-automation-kit",
	"version": "0.1.0",
	"description": "A typed, Zod-validated DAG workflow engine for TypeScript: composable nodes, context interpolation, parallel branches, persistence, and human-in-the-loop approval gates.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./examples": {
			"import": "./dist/examples/index.js",
			"types": "./dist/examples/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@earendil-works/gondolin": "^0.7.0",
		"@hono/node-server": "^1.19.9",
		"better-sqlite3": "^12.6.2",
		"hono": "^4.12.2",
		"nodemailer": "^8.0.1",
		"zod": "^3.22.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^20.0.0",
		"@types/node-forge": "^1.3.14",
		"@types/nodemailer": "^7.0.11",
		"typescript": "^5.4.0",
		"vitest": "^1.6.0"
	}
}
